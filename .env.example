# ==============================================================================
# ENTERPRISE AI COPILOT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Application Environment (development | staging | production)
APP_NAME="Enterprise HR Policy Agentic RAG Copilot"
APP_ENV=development

# ------------------------------------------------------------------------------
# LLM Inference Providers
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# (Optional) OpenAI API Key if using OpenAI models
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ------------------------------------------------------------------------------
# Vectorstore & Embedding Provider
# ------------------------------------------------------------------------------
# Pinecone API Key (Get at: https://app.pinecone.io/)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb

# Embedding Model (Supported: sentence-transformers/all-MiniLM-L6-v2 or text-embedding-3-small)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# External Web Fallback Provider
# ------------------------------------------------------------------------------
# Tavily Search API Key (Get at: https://app.tavily.com/)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Administrative Security & Access Control
# ------------------------------------------------------------------------------
# API Key for document ingestion (Passed via 'X-Admin-Key' header)
ADMIN_API_KEY=admin123

# Retrieval and retry limits
TOP_K=4
MAX_RETRIES=1

# ------------------------------------------------------------------------------
# Observability & Tracing (LangSmith - Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT="Enterprises-ai"
